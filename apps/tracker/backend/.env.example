# Local dev config — cp .env.example .env (gitignored), run from backend/
# (`cargo run`). All optional except TRACKER_ROOT; defaults in src/config.rs.
# Prod gets env from the raspi quadlet.

# Dev auth: /api/* is reachable without oauth2-proxy forward-auth headers.
# Never in prod.
DEV_AUTH=1

# Root of the module collection to scan. On the Mac this is the NAS mount
# (mods lives under the `scene` share); on the Pi it's the in-container mount.
# Sugar for a single `mods` root of kind `scan` — see TRACKER_ROOTS below.
TRACKER_ROOT=/Volumes/scene/mods

# Multiple collection roots: `id:kind:path`, comma-separated. Wins over
# TRACKER_ROOT when set. `id` is a lowercase slug (DB key + API), `kind` is:
#   scan — walk the tree and hash the bytes (the module pipeline)
#   hvsc — the High Voltage SID Collection, indexed from its own
#          DOCUMENTS/Songlengths.md5 instead of a filesystem walk; read-only
# The path is everything after the second colon, so paths may contain colons.
# The first root is primary: it owns library.json and receives Modland fetches.
# TRACKER_ROOTS=mods:scan:/Volumes/scene/mods,hvsc:hvsc:/Volumes/scene/hvsc/C64Music

# SQLite cache (path index + parsed metadata). Repo root, gitignored.
TRACKER_DB_PATH=../tracker.db

# Built SPA to serve (yarn build). With the Vite dev server (yarn dev on
# :5173) the proxy talks to :3010 either way.
STATIC_DIR=../frontend/dist

# How long to play a SID with no known length, in seconds (default 180, the
# sidplayfp convention). SID headers carry no duration; HVSC's Songlengths
# database supplies real ones for HVSC tunes, and a hand-curated SID's length is
# set by listening (the player writes it back). This is only the fallback — it is
# never shown as if it were the tune's actual length.
# TRACKER_SID_DEFAULT_LENGTH=180

# C64 ROMs for SID playback: a directory holding files whose names start with
# `kernal`, `basic` and `chargen` (VICE's names work — kernal-901227-03.bin).
# Served to the browser from here; operator-supplied and never committed, same
# posture as the Amiga Kickstarts. Unset is supported: libsidplayfp falls back to
# built-in images and most tunes play identically, but a BASIC-driven RSID
# collapses to near silence, so set it if you have them.
# TRACKER_ROMS_DIR=../../../data/roms

# TRACKER_BIND=0.0.0.0:3010
# RUST_LOG=info,tracker_backend=debug

# Optional: Modland base — the md5→author index (allmods.zip) + by-md5 module
# downloads used to fetch a playlist's missing songs. Defaults to the main host;
# override to a mirror or a test stub.
# MODLAND_BASE=https://ftp.modland.com

node_modules
.yarn/*
!.yarn/releases
.pnp.*
dist

# Playwright (browser e2e) — reports + traces, never committed
test-results
playwright-report
blob-report
.last-run.json

# Python sidecar
.venv
__pycache__
*.pyc

# Local data / caches / secrets
*.db
*.db-shm
*.db-wal

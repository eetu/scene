# Rust
/target
# bacon's exported jump locations
.bacon-locations

# Node / yarn (Berry, node-modules linker)
node_modules
.yarn/*
!.yarn/releases
.pnp.*
dist

# SvelteKit's generated types. Each app already ignores its own; this catches the one
# vitest drops at the repo root when it runs the shared package's browser suites.
/.svelte-kit

# Playwright (browser e2e) — reports + traces, never committed
test-results
playwright-report
blob-report
.last-run.json

# Python sidecar
.venv
__pycache__
*.pyc

# Local data / caches / secrets
*.db
*.db-shm
*.db-wal
apps/party/backend/cache
.env
.DS_Store
data/roms/

# Standalone (Pages) demo module — fetched at deploy time, never committed.
apps/tracker/frontend/static/demo/

# vitest browser mode artifacts (screenshots / attachments)
.vitest-attachments/
**/__screenshots__/

# Frames written by the visualiser tests — one PNG per viz per sampled frame, for
# eyeballing the collection as a set. Regenerated by running the tests.
packages/player/src/__tests__/viz-gallery/
packages/player/src/__tests__/crt/
packages/player/src/__tests__/vfd-plate/
packages/player/src/__tests__/nixie-shakedown/

# Raw Mixamo source for the dancer viz. Kept local, never committed: Mixamo's
# terms forbid redistributing their assets as standalone files. The committed
# asset is dancer.glb — decimated, stripped and merged by build-dancer.py, i.e.
# incorporated into this project rather than republished.
packages/player/src/assets/*.fbx
